annotate(geom="polygon", x=parks$path[[11]]$x, y=parks$path[[11]]$y,fill=NA,color="black",linewidth=1) +
theme(
panel.background = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank()
) +
guides(size = "none")
